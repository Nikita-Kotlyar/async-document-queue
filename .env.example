# Copy to .env and fill in real values. Never commit .env.
ADQ_ENVIRONMENT=production

# Published host ports (container ports stay fixed).
ADQ_API_PORT=8081
ADQ_POSTGRES_PORT=5433
ADQ_REDIS_PORT=6380
ADQ_RABBITMQ_PORT=5672
ADQ_RABBITMQ_MANAGEMENT_PORT=15672
ADQ_WEBHOOK_PORT=8090

# PostgreSQL
POSTGRES_USER=adq
POSTGRES_DB=adq
POSTGRES_PASSWORD=change-me

# RabbitMQ
RABBITMQ_DEFAULT_USER=adq
RABBITMQ_DEFAULT_PASS=change-me

# Application connections (compose service hostnames).
ADQ_DATABASE_URL=postgresql+asyncpg://adq:change-me@db:5432/adq
ADQ_SYNC_DATABASE_URL=postgresql+psycopg://adq:change-me@db:5432/adq
ADQ_REDIS_URL=redis://redis:6379/0
ADQ_BROKER_URL=amqp://adq:change-me@rabbitmq:5672//

# Webhook signing and optional API key.
ADQ_WEBHOOK_SECRET=change-me
ADQ_API_KEY=

# Processing policy.
ADQ_WEBHOOK_MAX_ATTEMPTS=4
ADQ_TASK_MAX_RETRIES=3
ADQ_MAX_UPLOAD_MB=25
ADQ_ENABLE_FAULT_INJECTION=true
ADQ_CELERY_TASK_ALWAYS_EAGER=false

# Optional for host-side runs; the container image sets /usr/bin/tesseract.
# ADQ_TESSERACT_CMD=/usr/bin/tesseract
# ADQ_OCR_LANG=rus+eng
